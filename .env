# ── Proxy mode (recommended) ──────────────────────────────────────────────
# Leave VITE_ENGINE_URL empty. Vite dev server proxies /api/* and /user/*
# to VITE_ENGINE_PROXY_TARGET server-side — no CORS, no cert issues.
VITE_ENGINE_URL=http://localhost:9002

# Real engine URL — used ONLY by vite.config.ts (never sent to the browser).
# VITE_ENGINE_PROXY_TARGET=https://35.244.14.151

# Optional: default Mind Share Key for code-repo CodeFlo chat.
# VITE_CODEFLO_SHARE_KEY=ask_...
