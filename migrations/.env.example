# ── Engine connection ─────────────────────────────────────────────────────────
# The URL of the AI Studio edge engine. This is a SERVER-SIDE ONLY variable —
# it must NOT be prefixed with NEXT_PUBLIC_. The Next.js Route Handler proxy
# reads it at request time; the browser bundle never sees it.
ENGINE_URL=https://your-engine-host.example.com

# Optional: shared CodeFlo Mind Share Key (used server-side in the engine proxy).
# Leave blank if every user supplies their own key at run time.
CODEFLO_SHARE_KEY=

# ── App base path ─────────────────────────────────────────────────────────────
# If this app is served at a sub-path (e.g. /tp-web/), set this and mirror
# it in next.config.js `basePath`. Leave empty for root deployment.
# NEXT_PUBLIC_BASE_PATH=
